# Python
__pycache__/
*.pyc

# Game-derived data: dumped from the game, never committed
dumps/
extracted/

# Local runtime data (calibration samples collected while playing)
app/data/

# One-off scripts (research, probes, helpers), kept local
scratch/

# Generated from the game's files by tools/build_tiles.py, build_icons.py and build_mapdata.py
app/web/tiles/
app/web/areas/
app/web/icons/
app/web/maps.json
app/web/mapdata.json
